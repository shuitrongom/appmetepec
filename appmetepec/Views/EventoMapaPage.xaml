<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:bottomsheet="http://pluginmauibottomsheet.com"
             xmlns:androidBottomsheet="http://pluginmauibottomsheet.com/platformconfiguration/android"
             x:Class="appmetepec.Views.EventoMapaPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <!-- Fuente institucional del modulo de Eventos: "Como" en todos los Label de esta pagina. -->
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Como" />
        </Style>
    </ContentPage.Resources>

    <!-- FASE 4 (estilo Google/Apple Maps) con BOTTOM SHEET NATIVO (Plugin.Maui.BottomSheet):
         DOS filas reales.
         Fila 0 (Auto): encabezado.
         Fila 1 (*): el MAPA (Viewport). Ocupa TODO el espacio bajo el encabezado; el bottom sheet
                     nativo flota ENCIMA como overlay anclado abajo (no ocupa fila del Grid), por lo
                     que en estado Peek solo cubre PeekHeight px desde abajo y el mapa queda completo
                     detras. El control nativo gestiona sus propios estados (Peek/Large), lo que
                     elimina de raiz el bug del Border manual (que al volver de un escenario no se
                     re-restringia a la nueva altura de fila en Android y tapaba el mapa). -->
    <Grid x:Name="RaizGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="12,10" BackgroundColor="White">
            <Label Grid.Column="0" Text="&#8592;" FontSize="26" TextColor="#5B2A86"
                   VerticalOptions="Center" WidthRequest="34">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" x:Name="TitleLabel" Text="Eventos" FontSize="18" FontAttributes="Bold"
                   VerticalOptions="Center" HorizontalOptions="Center" TextColor="#5B2A86"
                   LineBreakMode="TailTruncation" />
            <!-- Columna derecha reservada para equilibrar el titulo centrado (sin boton de zoom).
                 Es un ContentView vacio (NO un BoxView con Color="Transparent", que en iOS a
                 veces se renderiza como un cuadro NEGRO). Solo reserva ancho, no pinta nada. -->
            <ContentView Grid.Column="2" WidthRequest="34" />
        </Grid>

        <!-- Area del mapa: un contenedor fijo (clip) donde se mueve/escala el contenido. Ocupa
             toda la fila * bajo el encabezado; el bottom sheet se superpone encima (overlay),
             por lo que el Viewport conserva un tamano >0 y DimensionarLienzo sigue recibiendo
             dimensiones validas. Sin padding superior: el mapa arranca JUSTO bajo el encabezado
             (se elimino la franja gris superior que no se usaba). -->
        <Grid Grid.Row="1" x:Name="Viewport" IsClippedToBounds="True" BackgroundColor="#F4F1FA"
              Padding="6,0,6,0">

            <!-- Contenido que se escala y traslada (imagen + pines). Anclado ARRIBA
                 (VerticalOptions="Start") para que el mapa aproveche el alto disponible desde el
                 encabezado y NO quede una franja gris encima; el sobrante por AspectFit (si la
                 imagen es mas ancha que alta) cae abajo, donde el bottom sheet lo cubre. El
                 centrado horizontal (HorizontalOptions="Center") y el AspectFit de
                 DimensionarLienzo se conservan intactos. -->
            <AbsoluteLayout x:Name="MapaLayout" HorizontalOptions="Center" VerticalOptions="Start">
                <!-- La imagen llena el MapaLayout con AspectFit (nunca deforma). Como el
                     code-behind dimensiona el MapaLayout con la proporcion REAL del archivo
                     (medida tras cargar la imagen, no con los enteros del backend que pueden
                     tener redondeo), AspectFit no deja margen y la capa de pines coincide 1:1
                     con la imagen, igual que el admin. -->
                <Image x:Name="MapaImagen"
                       AbsoluteLayout.LayoutBounds="0,0,1,1"
                       AbsoluteLayout.LayoutFlags="All"
                       Aspect="AspectFit" />
                <!-- Los pines (hotspots) se agregan por codigo, posicionados por %. -->
            </AbsoluteLayout>

            <!-- Sin gestos de zoom/pan: el mapa se muestra fijo y completo. La interaccion es
                 tocar los pines (que flotan con sombra para dar profundidad 3D). -->

            <!-- Carga -->
            <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False"
                               HorizontalOptions="Center" VerticalOptions="Center" Color="#5B2A86" />

            <!-- Error de imagen con reintento -->
            <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="10"
                                 HorizontalOptions="Center" VerticalOptions="Center" Padding="24">
                <Label Text="No se pudo cargar el mapa del evento."
                       HorizontalTextAlignment="Center" TextColor="#555" FontSize="15" />
                <Button Text="Reintentar" Clicked="OnReintentarClicked"
                        BackgroundColor="#5B2A86" TextColor="White" CornerRadius="18" Padding="22,6" />
            </VerticalStackLayout>

            <!-- Boton flotante que ABRE el bottom sheet nativo (Escenarios / Mi agenda). El panel
                 ya no es permanente: el mapa se ve completo y, al tocar este boton, el sheet sube
                 (patron de las apps de mapas modernas). Pastilla morada anclada abajo-centro con
                 sombra. El code-behind (OnAbrirPanelTapped) hace PanelInferior.IsOpen=true. -->
            <Border x:Name="BotonAbrirPanel" VerticalOptions="End" HorizontalOptions="Center"
                    Margin="0,0,0,24" BackgroundColor="#5B2A86" StrokeThickness="0"
                    Padding="24,13" StrokeShape="RoundRectangle 28">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="12" Offset="0,4" />
                </Border.Shadow>
                <HorizontalStackLayout Spacing="9">
                    <Label Text="&#128205;" FontSize="17" VerticalTextAlignment="Center" />
                    <Label Text="Toca para ver escenarios y tu agenda ⭐" FontSize="13.5"
                           FontAttributes="Bold" TextColor="White" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAbrirPanelTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- ══ BOTTOM SHEET NATIVO (Plugin.Maui.BottomSheet v10) ══
             Reemplaza al Border manual por altura de fila. Es un panel NO-MODAL (IsModal=False)
             que flota sobre el mapa sin oscurecerlo ni bloquear el toque de los pines. Se declara
             como hijo del Grid raiz SIN Grid.Row: el control nativo se ancla al primer Layout de
             la pagina y se renderiza en su propia capa de plataforma, anclado abajo. Dos estados:
             Peek (colapsado, solo pista + segmento, ~PeekHeight px) y Large (expandido, pantalla
             casi completa para ver las listas). IsCancelable=False -> nunca se cierra del todo
             (siempre visible en Peek). IsDraggable=True -> arrastre nativo entre Peek/Large
             (reemplaza el OnSheetPan manual). HasHandle=True -> handle nativo. IsOpen=True al
             cargar. El contenido va con Content DIRECTO (no ContentTemplate) porque el code-behind
             rellena los hijos por x:Name (CrearSegmented, DibujarListaEscenarios, RefrescarMiAgenda)
             y deben existir siempre. -->
        <bottomsheet:BottomSheet x:Name="PanelInferior"
                                 IsOpen="False"
                                 IsModal="False"
                                 IsCancelable="True"
                                 IsDraggable="True"
                                 HasHandle="True"
                                 CornerRadius="20"
                                 States="Peek,Large"
                                 CurrentState="Peek"
                                 PeekHeight="320"
                                 androidBottomsheet:BottomSheet.HalfExpandedRatio="0.42"
                                 Closed="OnPanelCerrado"
                                 BackgroundColor="#FFFFFF">
            <bottomsheet:BottomSheetContent>
                <bottomsheet:BottomSheetContent.Content>
                    <Grid RowDefinitions="Auto,Auto,*">
                        <!-- Fila 0: la pista se oculta (la leyenda ya vive en el boton flotante del
                             mapa). Se conserva el x:Name y el elemento porque el code-behind lo
                             referencia; IsVisible=False evita el texto duplicado dentro del panel. -->
                        <Label Grid.Row="0" x:Name="PistaPeek"
                               Text="Escenarios · Mi agenda ⭐" IsVisible="False"
                               FontSize="12" TextColor="#9A8AAE"
                               HorizontalTextAlignment="Center" HorizontalOptions="Center"
                               Padding="0,8,0,6" />

                        <!-- Fila 1: segmented 'Escenarios | Mi agenda ⭐' (sus hijos se crean en CrearSegmented). -->
                        <Grid Grid.Row="1" x:Name="SegmentedHost" Padding="16,2,16,8" />

                        <!-- Fila 2: contenido con DOS scrolls superpuestos (uno visible a la vez). -->
                        <Grid Grid.Row="2">
                            <ScrollView x:Name="EscenariosScroll" Padding="16,0,16,12"
                                        VerticalScrollBarVisibility="Default">
                                <VerticalStackLayout x:Name="ListaEscenariosHost" Spacing="8">
                                    <!-- Subtitulo tenue (PistaSuperior): primer hijo del host; el metodo
                                         DibujarListaEscenarios lo respeta por ReferenceEquals. -->
                                    <Label x:Name="PistaSuperior"
                                           Text="Pica un número para ver las actividades del escenario"
                                           FontSize="12" TextColor="#9A8AAE"
                                           MaxLines="2" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </ScrollView>

                            <ScrollView x:Name="AgendaScroll" IsVisible="False" Padding="16,0,16,12"
                                        VerticalScrollBarVisibility="Default">
                                <VerticalStackLayout x:Name="AgendaHost" Spacing="4" />
                            </ScrollView>
                        </Grid>
                    </Grid>
                </bottomsheet:BottomSheetContent.Content>
            </bottomsheet:BottomSheetContent>
        </bottomsheet:BottomSheet>

        <!-- ══ INTRO DE PORTADA (overlay) ══
             Cubre toda la pantalla (las 2 filas) y se muestra UNA sola vez al abrir el
             evento si este trae imagenPortadaUrl. Fade + zoom suave; se puede saltar con un
             toque. El code-behind la oculta tras ~2.2 s o al tocar. Si no hay portada, nunca
             se hace visible y el flujo va directo al mapa. Declarado al final -> mayor Z ->
             cubre encabezado y mapa durante la intro. -->
        <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="IntroOverlay" IsVisible="False"
              InputTransparent="False" BackgroundColor="Transparent">
            <Image x:Name="PortadaImagen" Aspect="AspectFill"
                   HorizontalOptions="Fill" VerticalOptions="Fill" />
            <Label Text="Toca para entrar" FontSize="13" TextColor="White"
                   HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,40"
                   Opacity="0.9" BackgroundColor="#55000000" Padding="16,8" />
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSaltarIntroTapped" />
            </Grid.GestureRecognizers>
        </Grid>
    </Grid>
</ContentPage>
