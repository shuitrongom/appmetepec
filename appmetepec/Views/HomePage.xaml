<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:appmetepec.Views"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="appmetepec.Views.HomePage"
             Title="Metepec *7311"
             ios:Page.UseSafeArea="True"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <DataTemplate x:Key="PromoBannerTemplate">
            <Grid HeightRequest="64" ColumnDefinitions="*,*" ColumnSpacing="0">
                <Grid BackgroundColor="{Binding LeftBackground}" Padding="14,0" ColumnDefinitions="42,*">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPromoBannerTapped" CommandParameter="{Binding LeftTitle}" />
                    </Grid.GestureRecognizers>
                    <Image Source="{Binding LeftIcon}" HeightRequest="42" WidthRequest="42" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label Text="{Binding LeftTitle}" FontSize="19" FontAttributes="Bold" TextColor="White" />
                        <Label Text="{Binding LeftSubtitle}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                    </VerticalStackLayout>
                </Grid>
                <Grid Grid.Column="1" BackgroundColor="{Binding RightBackground}" Padding="14,0" ColumnDefinitions="42,*">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPromoBannerTapped" CommandParameter="{Binding RightTitle}" />
                    </Grid.GestureRecognizers>
                    <Image Source="{Binding RightIcon}" HeightRequest="42" WidthRequest="42" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label Text="{Binding RightTitle}" FontSize="19" FontAttributes="Bold" TextColor="White" />
                        <Label Text="{Binding RightSubtitle}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Noticia destacada+vigente agregada al final del carrusel (ver HomePage.ShowNews):
             una sola por slide (no pareada como los banners promocionales), con la misma imagen
             miniatura + titulo que ya usa la lista de la pestaña Noticias (NewsView), para que se
             reconozca como el mismo tipo de contenido. -->
        <DataTemplate x:Key="NewsBannerTemplate">
            <Grid HeightRequest="64" ColumnDefinitions="56,*" ColumnSpacing="12" Padding="14,0"
                  BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBannerNewsTapped" />
                </Grid.GestureRecognizers>
                <Border StrokeThickness="0" Padding="0" HeightRequest="48" WidthRequest="48" HorizontalOptions="Start" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Image Source="{Binding image}" Aspect="AspectFill" HeightRequest="48" WidthRequest="48" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="NOTICIA DESTACADA" FontSize="10" FontAttributes="Bold" TextColor="#F89A1C" />
                    <Label Text="{Binding title}" FontAttributes="Bold" FontSize="14"
                           TextColor="{AppThemeBinding Light=#28113E, Dark=White}"
                           LineBreakMode="TailTruncation" MaxLines="1" />
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>

        <views:BannerTemplateSelector x:Key="BannerSelector"
                                       PromoTemplate="{StaticResource PromoBannerTemplate}"
                                       NewsTemplate="{StaticResource NewsBannerTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,75">
        <VerticalStackLayout Grid.Row="0" Spacing="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1f1f1f}">
            <Grid Padding="25,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Label Text="&#8801;" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" VerticalOptions="Center" HorizontalOptions="Start" WidthRequest="30">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Image x:Name="LogoImage" Grid.Column="1" Source="placeholder.png" HeightRequest="50" WidthRequest="100" Aspect="AspectFit" />

                <HorizontalStackLayout Grid.Column="2" Spacing="14" HorizontalOptions="End" VerticalOptions="Center">
                    <Image Source="alerta_naranja.png" HeightRequest="30" WidthRequest="30" Aspect="AspectFit">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPanicoTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image Source="phone_call_green.png" HeightRequest="32" WidthRequest="32" Aspect="AspectFit">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLlamarTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                </HorizontalStackLayout>
            </Grid>

            <CarouselView x:Name="BannerCarousel"
                          HeightRequest="64"
                          IsBounceEnabled="True"
                          Loop="True"
                          PeekAreaInsets="0"
                          HorizontalScrollBarVisibility="Never"
                          ItemTemplate="{StaticResource BannerSelector}">
            </CarouselView>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <Grid>
                    <VerticalStackLayout x:Name="ReportsContent" Padding="28,26,28,20" Spacing="26">
                        <VerticalStackLayout x:Name="CategoriesHost" Spacing="28" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="NewsContent" Padding="28,26,28,20" Spacing="18" IsVisible="False">
                        <!--Label Text="NOTICIAS" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" /-->

                        <Border x:Name="FeaturedNewsCard" StrokeThickness="0" Padding="0" HeightRequest="210" IsVisible="False">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFeaturedNewsTapped" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Image x:Name="FeaturedNewsImage" Aspect="AspectFill" />
                                <BoxView>
                                    <BoxView.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="Transparent" Offset="0.0" />
                                            <GradientStop Color="#CC000000" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </BoxView.Background>
                                </BoxView>
                                <VerticalStackLayout VerticalOptions="End" Padding="16,12" Spacing="4">
                                    <Label x:Name="FeaturedNewsTitle" TextColor="White" FontAttributes="Bold" FontSize="19" LineBreakMode="TailTruncation" MaxLines="2" />
                                    <Label x:Name="FeaturedNewsSubtitle" TextColor="#E6E6E6" FontSize="13" LineBreakMode="TailTruncation" MaxLines="2" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <CollectionView x:Name="NewsView" SelectionMode="Single" SelectionChanged="OnNewsSelected">
                            <CollectionView.EmptyView>
                                <Label Text="Sin noticias cargadas." TextColor="{AppThemeBinding Light=#6B7280, Dark=#9AA5B1}" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="64,*" ColumnSpacing="12" Padding="0,10">
                                        <Border StrokeThickness="0" Padding="0" HeightRequest="64" WidthRequest="64" HorizontalOptions="Start" VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding image}" Aspect="AspectFill" HeightRequest="64" WidthRequest="64" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding title}" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#333, Dark=White}" LineBreakMode="TailTruncation" MaxLines="2" />
                                            <Label Text="{Binding subtitle}" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B0B8C1}" LineBreakMode="TailTruncation" MaxLines="2" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <Border Grid.Row="2" BackgroundColor="{AppThemeBinding Light=White, Dark=#1f1f1f}" StrokeThickness="0" Padding="0">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.10" Radius="8" Offset="0,-2" />
            </Border.Shadow>
            <!-- Barra inferior. La 3a columna (Eventos) solo aparece cuando hay un evento
                 activo; el code-behind ajusta las columnas para que no quede hueco.
                 Padding inferior extra (8) para separarla del borde en telefonos con barra de
                 gestos; los textos hacen wrap a 2 lineas y se centran para que ninguno (ni el
                 largo "GERENCIA DE LA CIUDAD") se corte en pantallas angostas. -->
            <Grid x:Name="BottomTabsGrid" ColumnDefinitions="*,*" Padding="12,10,12,8" ColumnSpacing="8">
                <Border x:Name="ReportsTab" BackgroundColor="#F1EEFB" StrokeThickness="0" Padding="4,8" HorizontalOptions="Fill" VerticalOptions="Fill" MinimumHeightRequest="58">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Image Source="ic_gerencia_cd.png" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" />
                        <Label x:Name="ReportsTabLabel" Text="GERENCIA DE LA CIUDAD" FontSize="9" FontAttributes="Bold" TextColor="#28113E"
                               HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnReportsTabTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <Border x:Name="NewsTab" Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" Padding="4,8" HorizontalOptions="Fill" VerticalOptions="Fill" MinimumHeightRequest="58">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Image Source="btn_noticias.png" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" />
                        <Label x:Name="NewsTabLabel" Text="NOTICIAS" FontSize="9" FontAttributes="Bold" TextColor="#9AA5B1"
                               HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNewsTabTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Tab Eventos: oculto por defecto; se muestra cuando hay evento activo. -->
                <Border x:Name="EventosTab" Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0" Padding="4,8" HorizontalOptions="Fill" VerticalOptions="Fill" MinimumHeightRequest="58" IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label Text="&#127914;" FontSize="20" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label x:Name="EventosTabLabel" Text="EVENTOS" FontSize="9" FontAttributes="Bold" TextColor="#9AA5B1"
                               HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEventosTabTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <ActivityIndicator x:Name="BusyIndicator" Grid.RowSpan="3" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center" />

        <BoxView x:Name="DrawerBackdrop" Grid.RowSpan="3" BackgroundColor="#80000000" IsVisible="False" InputTransparent="False" ZIndex="90">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDrawerBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="DrawerPanel"
                Grid.RowSpan="3"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1f1f1f}"
                StrokeThickness="0"
                WidthRequest="272"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                TranslationX="-272"
                ZIndex="100">
            <ScrollView>
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout BackgroundColor="{AppThemeBinding Light=White, Dark=#1f1f1f}" Padding="80,40,22,22" Spacing="10">
                        <Image Source="placeholder.png" HeightRequest="46" WidthRequest="92" Aspect="AspectFit" HorizontalOptions="Start" />
                        <Label x:Name="DrawerUserLabel" Text="Metepec *7311" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#000000, Dark=White}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Padding="0,10" Spacing="2">
                        <Grid ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14">
                            <Image Source="ic_gerencia_cd.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="Inicio" FontSize="15" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerHomeTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <Grid ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14">
                            <Image Source="ic_denuncia_ciudadana.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="Mis reportes" FontSize="15" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerMyTicketsTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <Grid ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14">
                            <Image Source="ic_user.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="Mi perfil" FontSize="15" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerPerfilTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <!--
                        <Grid ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14">
                            <Image Source="ic_trash.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="Recoleccion de basura" FontSize="15" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerRecoleccionTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <Grid ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14">
                            <Image Source="ic_alerta_on.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="Alerta de genero" FontSize="15" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerAlertaTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        -->

                        <Grid ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14">
                            <Image Source="btn_noticias.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="Noticias" FontSize="15" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerNoticiasTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <!-- Eventos: a un lado de Noticias. Solo visible si hay un evento activo
                             (se controla desde el admin del backend: desactivar = desaparece). -->
                        <Grid x:Name="DrawerEventosItem" ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14" IsVisible="False">
                            <Label Text="&#127914;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="DrawerEventosLabel" Text="Eventos" FontSize="15" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerEventosTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E5E5E5, Dark=#33383D}" Margin="20,10" />

                        <Grid ColumnDefinitions="46,*,Auto" Padding="20,14" ColumnSpacing="14">
                            <Label Text="&#127769;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Tema oscuro" FontSize="15" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" VerticalOptions="Center" />
                            <Switch x:Name="DarkThemeSwitch" Grid.Column="2" Toggled="OnDarkThemeToggled" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E5E5E5, Dark=#33383D}" Margin="20,10" />

                        <Grid ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14">
                            <Label Text="&#10162;" FontSize="20" TextColor="#C0392B" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="Cerrar sesion" FontSize="15" TextColor="#C0392B" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerLogoutTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <Label x:Name="DrawerVersionLabel"
                               HorizontalTextAlignment="Center"
                               FontSize="12"
                               TextColor="#AAAAAA"
                               Margin="0,16,0,10" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
