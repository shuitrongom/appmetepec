<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.HomePage"
             Title="Metepec *7311"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White"
             BackgroundImageSource="bg5.png">
    <Grid RowDefinitions="Auto,*,75">
        <VerticalStackLayout Grid.Row="0" Spacing="0" BackgroundColor="White">
            <Grid Padding="25,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Label Text="&#8801;" FontSize="26" FontAttributes="Bold" TextColor="#28113E" VerticalOptions="Center" HorizontalOptions="Start" WidthRequest="30">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Image Grid.Column="1" Source="logo.png" HeightRequest="50" WidthRequest="100" Aspect="AspectFit" />

                <HorizontalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                    <Label Text="ALERTA DE&#10;GENERO" FontSize="10" FontAttributes="Bold" TextColor="#555" HorizontalTextAlignment="End" VerticalOptions="Center" />
                    <Image Source="ic_alerta_on.png" HeightRequest="30" WidthRequest="30" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAlertaTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
            </Grid>

            <CarouselView x:Name="BannerCarousel"
                          HeightRequest="64"
                          IsBounceEnabled="True"
                          Loop="True"
                          PeekAreaInsets="0"
                          HorizontalScrollBarVisibility="Never">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Grid HeightRequest="64" ColumnDefinitions="*,*" ColumnSpacing="0">
                            <Grid BackgroundColor="{Binding LeftBackground}" Padding="14,0" ColumnDefinitions="42,*">
                                <Image Source="{Binding LeftIcon}" HeightRequest="42" WidthRequest="42" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding LeftTitle}" FontSize="19" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="{Binding LeftSubtitle}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid Grid.Column="1" BackgroundColor="{Binding RightBackground}" Padding="14,0" ColumnDefinitions="42,*">
                                <Image Source="{Binding RightIcon}" HeightRequest="42" WidthRequest="42" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding RightTitle}" FontSize="19" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="{Binding RightSubtitle}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <Grid>
                    <VerticalStackLayout x:Name="ReportsContent" Padding="28,26,28,20" Spacing="26">
                        <VerticalStackLayout x:Name="CategoriesHost" Spacing="28" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="NewsContent" Padding="28,26,28,20" Spacing="14" IsVisible="False">
                        <Label Text="NOTICIAS" FontSize="28" FontAttributes="Bold" TextColor="#555" />
                        <CollectionView x:Name="NewsView" SelectionMode="Single" SelectionChanged="OnNewsSelected">
                            <CollectionView.EmptyView>
                                <Label Text="Sin noticias cargadas." TextColor="#6B7280" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="14" Margin="0,0,0,12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="84,*" ColumnSpacing="12">
                                            <Image Source="{Binding image}" HeightRequest="74" WidthRequest="74" Aspect="AspectFill" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Label Text="{Binding title}" FontAttributes="Bold" TextColor="#333" />
                                                <Label Text="{Binding subtitle}" TextColor="#666" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" BackgroundColor="#080808">
            <VerticalStackLayout x:Name="ReportsTab" Padding="8" Spacing="4" BackgroundColor="#050505" HorizontalOptions="Fill" VerticalOptions="Center">
                <Image Source="ic_gerencia_cd.png" HeightRequest="25" WidthRequest="25" HorizontalOptions="Center" />
                <Label Text="GERENCIA DE LA CIUDAD" FontSize="10" FontAttributes="Bold" TextColor="#9F8AD0" HorizontalTextAlignment="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnReportsTabTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="NewsTab" Grid.Column="1" Padding="8" Spacing="4" BackgroundColor="#1A1A1A" HorizontalOptions="Fill" VerticalOptions="Center">
                <Image Source="btn_noticias.png" HeightRequest="25" WidthRequest="25" HorizontalOptions="Center" />
                <Label Text="NOTICIAS" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNewsTabTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
        </Grid>

        <ActivityIndicator x:Name="BusyIndicator" Grid.RowSpan="3" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center" />

        <BoxView x:Name="DrawerBackdrop" Grid.RowSpan="3" BackgroundColor="#80000000" IsVisible="False" InputTransparent="False" ZIndex="90">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDrawerBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="DrawerPanel"
                Grid.RowSpan="3"
                BackgroundColor="White"
                StrokeThickness="0"
                WidthRequest="272"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                TranslationX="-272"
                ZIndex="100">
            <ScrollView>
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout BackgroundColor="#000336" Padding="22,60,22,22" Spacing="10">
                        <Image Source="logo.png" HeightRequest="46" WidthRequest="92" Aspect="AspectFit" HorizontalOptions="Start" />
                        <Label x:Name="DrawerUserLabel" Text="Metepec *7311" FontSize="15" FontAttributes="Bold" TextColor="White" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Padding="0,10" Spacing="2">
                        <Grid ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14">
                            <Image Source="ic_gerencia_cd.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="Inicio" FontSize="15" TextColor="#28113E" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerHomeTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <Grid ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14">
                            <Image Source="ic_denuncia_ciudadana.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="Mis reportes" FontSize="15" TextColor="#28113E" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerMyTicketsTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <Grid ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14">
                            <Image Source="ic_trash.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="Recoleccion de basura" FontSize="15" TextColor="#28113E" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerRecoleccionTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <Grid ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14">
                            <Image Source="ic_alerta_on.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="Alerta de genero" FontSize="15" TextColor="#28113E" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerAlertaTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <Grid ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14">
                            <Image Source="btn_noticias.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="Noticias" FontSize="15" TextColor="#28113E" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerNoticiasTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#E5E5E5" Margin="20,10" />

                        <Grid ColumnDefinitions="46,*" Padding="20,14" ColumnSpacing="14">
                            <Label Text="&#10162;" FontSize="20" TextColor="#C0392B" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="Cerrar sesion" FontSize="15" TextColor="#C0392B" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerLogoutTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
