<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.RegisterPage"
             Title="Registro"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="White"
             BackgroundImageSource="bg5.png">
    <ScrollView>
        <VerticalStackLayout Padding="30,50,30,28" Spacing="20">

            <Image Source="logo.png" HeightRequest="120" Aspect="AspectFit" HorizontalOptions="Center" />

            <VerticalStackLayout x:Name="FormPanel" Spacing="14">
                <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="#F4FAFD" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry x:Name="NombreEntry" Placeholder="Nombre" FontSize="18" BackgroundColor="Transparent" TextColor="#555" HorizontalTextAlignment="Center" HeightRequest="52" />
                </Border>
                <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="#F4FAFD" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry x:Name="ApellidoEntry" Placeholder="Apellido paterno" FontSize="18" BackgroundColor="Transparent" TextColor="#555" HorizontalTextAlignment="Center" HeightRequest="52" />
                </Border>
                <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="#F4FAFD" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry x:Name="PhoneEntry" Placeholder="Telefono a 10 digitos" Keyboard="Telephone" FontSize="18" BackgroundColor="Transparent" TextColor="#555" HorizontalTextAlignment="Center" HeightRequest="52" />
                </Border>
                <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="#F4FAFD" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry x:Name="EmailEntry" Placeholder="Correo Electronico" Keyboard="Email" FontSize="18" BackgroundColor="Transparent" TextColor="#555" HorizontalTextAlignment="Center" HeightRequest="52" />
                </Border>
                <Label Text="Tu usuario y contraseña se generan automaticamente; te los mostraremos al terminar el registro." FontSize="12" TextColor="#888888" HorizontalTextAlignment="Center" />

                <Button x:Name="RegisterButton"
                        Text="REGISTRAR"
                        Clicked="OnRegisterClicked"
                        BackgroundColor="#F89A1C"
                        TextColor="White"
                        FontSize="20"
                        FontAttributes="Bold"
                        HeightRequest="58"
                        Margin="0,10,0,0" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="CodePanel" Spacing="14" IsVisible="False">
                <Label Text="Te enviamos un codigo de verificacion por SMS." FontSize="15" TextColor="#555555" HorizontalTextAlignment="Center" />
                <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="#F4FAFD" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry x:Name="CodeEntry" Placeholder="Codigo de verificacion" Keyboard="Numeric" FontSize="20" BackgroundColor="Transparent" TextColor="#555" HorizontalTextAlignment="Center" HeightRequest="52" />
                </Border>
                <Label x:Name="TimerLabel" Text="0:59" FontSize="28" FontAttributes="Bold" TextColor="#F89A1C" HorizontalTextAlignment="Center" />

                <Button x:Name="VerifyButton"
                        Text="VERIFICAR"
                        Clicked="OnVerifyClicked"
                        BackgroundColor="#F89A1C"
                        TextColor="White"
                        FontSize="20"
                        FontAttributes="Bold"
                        HeightRequest="58" />

                <Label x:Name="ResendLabel" Text="VOLVER A ENVIAR CODIGO" FontSize="13" FontAttributes="Bold" TextColor="#555555" Opacity="0.3" HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnResendTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="MODIFICAR DATOS" FontSize="13" FontAttributes="Bold" TextColor="#555555" HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnModifyTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" Color="#F89A1C" HorizontalOptions="Center" />

            <Label Text="Volver a inicio de sesion" FontSize="16" TextColor="#F89A1C" HorizontalTextAlignment="Center" Margin="0,10,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackToLoginTapped" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
