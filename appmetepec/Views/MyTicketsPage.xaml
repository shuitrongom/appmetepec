<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.MyTicketsPage"
             Title="Mis reportes"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#555"
             BackgroundImageSource="bg8.png">
    <Grid RowDefinitions="Auto,*">
        <Grid BackgroundColor="White" Padding="25,12" ColumnDefinitions="40,*,40">
            <Label Text="‹" FontSize="30" TextColor="#28113E" VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Image Grid.Column="1" Source="logo.png" HeightRequest="50" WidthRequest="100" Aspect="AspectFit" HorizontalOptions="Center" />
            <Image Grid.Column="2" Source="ic_alerta_on.png" HeightRequest="30" WidthRequest="30" />
        </Grid>

        <RefreshView Grid.Row="1" x:Name="TicketsRefreshView" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="10">
                    <ActivityIndicator x:Name="BusyIndicator" Color="White" />

                    <VerticalStackLayout x:Name="PendingSection" Spacing="10" IsVisible="False" Margin="0,0,0,10">
                        <Label Text="PENDIENTES POR ENVIAR" FontSize="16" FontAttributes="Bold" TextColor="#F89A1C" />
                        <CollectionView x:Name="PendingView">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Stroke="#F89A1C" StrokeThickness="1" BackgroundColor="White" Padding="14" Margin="0,0,0,12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" TextColor="#28113E" />
                                            <Label FontSize="11" TextColor="#8A9BA8">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Guardado el " />
                                                        <Span Text="{Binding SavedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}" />
                                                    </FormattedString>
                                            </Label.FormattedText>
                                            </Label>
                                            <Label Text="{Binding LastError}" FontSize="11" TextColor="#C0392B" LineBreakMode="TailTruncation" MaxLines="2" />
                                            <HorizontalStackLayout Spacing="10" Margin="0,6,0,0">
                                                <Button Text="Reintentar envio" Clicked="OnRetryPendingClicked" BackgroundColor="#F89A1C" TextColor="White" FontSize="12" HeightRequest="38" />
                                                <Button Text="Descartar" Clicked="OnDiscardPendingClicked" BackgroundColor="#EEE" TextColor="#555" FontSize="12" HeightRequest="38" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <Label Text="MIS REPORTES" FontSize="20" FontAttributes="Bold" TextColor="White" Margin="0,10,0,6" />

                    <CollectionView x:Name="TicketsView" SelectionMode="Single" SelectionChanged="OnTicketSelected">
                        <CollectionView.EmptyView>
                            <Label Text="Aun no has enviado ningun reporte." TextColor="White" FontSize="14" Margin="0,20,0,0" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="White" Padding="14" Margin="0,0,0,12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Asunto}" FontAttributes="Bold" FontSize="15" TextColor="#28113E" LineBreakMode="TailTruncation" />
                                            <Border Grid.Column="1" BackgroundColor="{Binding Colorestatus, Converter={StaticResource HexToColorConverter}}" Padding="8,3" VerticalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Descestatus}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding Descservicio}" FontSize="12" TextColor="#555" />
                                        <Label FontSize="11" TextColor="#8A9BA8">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Folio}" />
                                                    <Span Text="  •  " />
                                                    <Span Text="{Binding Fechaalta, StringFormat='{0:dd/MM/yyyy HH:mm}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
