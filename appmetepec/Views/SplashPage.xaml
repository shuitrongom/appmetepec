<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="appmetepec.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:appmetepec.ViewModels"
    x:Name="SplashRoot"
    x:DataType="viewmodels:SplashViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Behaviors>
        <!-- Desde CommunityToolkit.Maui 10 los behaviors ya no heredan el BindingContext de la
             pagina; sin asignarlo explicitamente InitializeCommand nunca se ejecuta y la app se
             queda en el splash. -->
        <toolkit:EventToCommandBehavior
            EventName="Loaded"
            BindingContext="{Binding Path=BindingContext, Source={x:Reference SplashRoot}, x:DataType=ContentPage}"
            Command="{Binding InitializeCommand}" />
    </ContentPage.Behaviors>

    <Grid>

        <Image
            x:Name="BackgroundImage"
            Source="splash.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            Opacity="0" />

        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            Color="White"
            VerticalOptions="End"
            Margin="0,0,0,40" />

    </Grid>
</ContentPage>
