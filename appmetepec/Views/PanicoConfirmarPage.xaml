<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.PanicoConfirmarPage"
             Title="Confirmar emergencia">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Image Source="alerta_naranja.png" HeightRequest="110" WidthRequest="110" HorizontalOptions="Center" Margin="0,24,0,0" />
            <Label Text="¿CONFIRMAS LA EMERGENCIA?" FontSize="20" FontAttributes="Bold" TextColor="#C0392B" HorizontalTextAlignment="Center" Margin="20,16,20,8" />
            <Label Text="Se notificará de inmediato a C2 con tu ubicación y datos de contacto, se generará un ticket y se iniciará una llamada. Confirma solo si se trata de una emergencia real."
                   FontSize="14" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" HorizontalTextAlignment="Center" Margin="24,0,24,20" />

            <Border Stroke="{AppThemeBinding Light=#DDD, Dark=#3A3A3A}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#2A2A2A}" Margin="20,0,20,20" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="NombreLabel" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" />
                    <Label x:Name="TelefonoLabel" FontSize="13" TextColor="{AppThemeBinding Light=#555, Dark=#C7CDD3}" />
                    <Label x:Name="DireccionLabel" FontSize="13" TextColor="{AppThemeBinding Light=#555, Dark=#C7CDD3}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="20,0,20,26" Spacing="10">
                <Button x:Name="ConfirmarButton" Text="SÍ, ES UNA EMERGENCIA" Clicked="OnConfirmarClicked" BackgroundColor="#C0392B" TextColor="White" FontSize="18" FontAttributes="Bold" />
                <Button Text="CANCELAR" Clicked="OnCancelarClicked" BackgroundColor="{AppThemeBinding Light=#DDD, Dark=#3A3A3A}" TextColor="{AppThemeBinding Light=#333, Dark=White}" FontSize="14" />
                <ActivityIndicator x:Name="BusyIndicator" Color="{AppThemeBinding Light=#28113E, Dark=White}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
