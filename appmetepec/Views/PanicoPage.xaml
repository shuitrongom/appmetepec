<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.PanicoPage"
             Title="Botón de pánico">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Image Source="placeholder.png" HeightRequest="50" WidthRequest="100" Aspect="AspectFit" Margin="25,12,25,0" />
            <Image Source="alerta_naranja.png" HeightRequest="110" WidthRequest="110" HorizontalOptions="Center" Margin="0,16,0,0" />
            <Label Text="BOTÓN DE PÁNICO" FontSize="20" FontAttributes="Bold" TextColor="#C0392B" BackgroundColor="White" Padding="15" HorizontalTextAlignment="Center" Margin="0,16,0,16" />
            <Label Text="Úsalo solo en una emergencia real. Se enviará tu ubicación y datos a C2 y se iniciará una llamada."
                   FontSize="13" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" HorizontalTextAlignment="Center" Margin="20,0,20,16" />

            <VerticalStackLayout Padding="20,0,20,26" Spacing="10">
                <Border Stroke="{AppThemeBinding Light=#DDD, Dark=#3A3A3A}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Entry x:Name="NameEntry" Placeholder="Nombre" FontSize="15" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#333, Dark=White}" HorizontalTextAlignment="Center" HeightRequest="46" />
                </Border>
                <Border Stroke="{AppThemeBinding Light=#DDD, Dark=#3A3A3A}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Entry x:Name="PhoneEntry" Placeholder="Telefono" Keyboard="Telephone" FontSize="15" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#333, Dark=White}" HorizontalTextAlignment="Center" HeightRequest="46" />
                </Border>
                <Border Stroke="{AppThemeBinding Light=#DDD, Dark=#3A3A3A}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Entry x:Name="EmailEntry" Placeholder="Correo" Keyboard="Email" FontSize="15" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#333, Dark=White}" HorizontalTextAlignment="Center" HeightRequest="46" />
                </Border>
                <Border Stroke="{AppThemeBinding Light=#DDD, Dark=#3A3A3A}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Editor x:Name="AddressEditor" Placeholder="Direccion" FontSize="15" AutoSize="TextChanges" HeightRequest="80" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#333, Dark=White}" HorizontalTextAlignment="Center" />
                </Border>
                <Button Text="USAR UBICACION" Clicked="OnUseLocationClicked" BackgroundColor="#A6CE39" TextColor="White" FontSize="12" FontAttributes="Bold" />
                <Label x:Name="CoordinatesLabel" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" FontSize="12" />
                <Button Text="CONTINUAR" Clicked="OnContinuarClicked" BackgroundColor="#C0392B" TextColor="White" FontSize="20" FontAttributes="Bold" Margin="0,10,0,0" />
                <Button Text="CANCELAR" Clicked="OnCancelarClicked" BackgroundColor="{AppThemeBinding Light=#DDD, Dark=#3A3A3A}" TextColor="{AppThemeBinding Light=#333, Dark=White}" FontSize="14" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
