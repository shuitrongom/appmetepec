<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.ReportPage"
             Title="Reporte"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#555"
             BackgroundImageSource="bg8.png">
    <Grid RowDefinitions="Auto,*">
        <Grid BackgroundColor="White" Padding="25,12" ColumnDefinitions="40,*,40">
            <Label Text="‹" FontSize="30" TextColor="#28113E" VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Image Grid.Column="1" Source="logo.png" HeightRequest="50" WidthRequest="100" Aspect="AspectFit" HorizontalOptions="Center" />
            <Image Grid.Column="2" Source="ic_alerta_on.png" HeightRequest="30" WidthRequest="30" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="34,20,34,26" Spacing="16">
                <Grid ColumnDefinitions="60,*" ColumnSpacing="10" Margin="0,0,0,8">
                    <Image x:Name="ReportIcon" HeightRequest="50" WidthRequest="50" Aspect="AspectFit" />
                    <Label x:Name="TitleLabel" Grid.Column="1" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                </Grid>

                <Label Text="Proporciona la siguiente informacion para darle seguimiento a tu reporte"
                       FontSize="15"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,16" />
                <Label x:Name="InstructionsLabel" TextColor="White" FontSize="12" IsVisible="False" />

                <Entry x:Name="NameEntry" Placeholder="Nombre" FontSize="12" BackgroundColor="White" TextColor="#333" HorizontalTextAlignment="Center" HeightRequest="44" />
                <Entry x:Name="PhoneEntry" Placeholder="Telefono" Keyboard="Telephone" FontSize="12" BackgroundColor="White" TextColor="#333" HorizontalTextAlignment="Center" HeightRequest="44" />
                <Entry x:Name="EmailEntry" Placeholder="Correo" Keyboard="Email" FontSize="12" BackgroundColor="White" TextColor="#333" HorizontalTextAlignment="Center" HeightRequest="44" />

                <Grid>
                    <Editor x:Name="AddressEditor" Placeholder="Direccion" FontSize="12" AutoSize="TextChanges" HeightRequest="110" BackgroundColor="White" TextColor="#333" HorizontalTextAlignment="Center" />
                    <Button Text="Elige tu direccion en el mapa" Clicked="OnUseLocationClicked" ImageSource="ic_marker.png" BackgroundColor="#A6CE39" TextColor="White" FontSize="10" WidthRequest="160" HeightRequest="36" HorizontalOptions="Start" VerticalOptions="End" />
                </Grid>
                <Label x:Name="CoordinatesLabel" TextColor="White" FontSize="12" />

                <Editor x:Name="CommentsEditor" Placeholder="Observaciones o referencias" FontSize="12" AutoSize="TextChanges" HeightRequest="90" BackgroundColor="White" TextColor="#333" HorizontalTextAlignment="Center" />

                <Label Text="Agrega un testigo:" TextColor="White" FontSize="12" />
                <HorizontalStackLayout Spacing="14">
                    <Image Source="btn_camara.png" HeightRequest="50" WidthRequest="50">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickImageTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image Source="placeholder_imagepreview.png" HeightRequest="70" WidthRequest="70" />
                </HorizontalStackLayout>
                <Label x:Name="AttachmentLabel" TextColor="White" FontSize="12" />

                <Button x:Name="SendButton" Text="ENVIAR" Clicked="OnSendClicked" BackgroundColor="#F89A1C" TextColor="White" FontSize="20" FontAttributes="Bold" WidthRequest="220" HeightRequest="52" HorizontalOptions="Center" />
                <ActivityIndicator x:Name="BusyIndicator" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
