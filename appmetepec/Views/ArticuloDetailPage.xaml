<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.ArticuloDetailPage"
             Title="Artículo"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    <Grid RowDefinitions="Auto,*">
        <Grid BackgroundColor="White" Padding="25,12" ColumnDefinitions="40,*,40">
            <Label Text="‹" FontSize="30" TextColor="#28113E" VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Image Grid.Column="1" Source="logo.png" HeightRequest="50" WidthRequest="100" Aspect="AspectFit" HorizontalOptions="Center" />
            <Image Grid.Column="2" Source="ic_alerta_on.png" HeightRequest="30" WidthRequest="30" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="6">
                <Label x:Name="TitleLabel" FontSize="20" FontAttributes="Bold" TextColor="#9780BB" />
                <Label x:Name="ContentLabel" FontSize="14" TextColor="Black" LineBreakMode="WordWrap" Margin="0,10,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
