<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.LoginPage"
             Title="Acceso"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="White"
             BackgroundImageSource="bg5.png">
    <ScrollView>
        <VerticalStackLayout Padding="30,16,30,24" Spacing="18">

            <Image Source="logo.png" HeightRequest="190" Aspect="AspectFit" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="12" Margin="0,12,0,0">
                <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="#F4FAFD" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry x:Name="UsernameEntry"
                           Placeholder="Usuario o Correo Electronico"
                           FontSize="17"
                           BackgroundColor="Transparent"
                           TextColor="#555"
                           Keyboard="Email"
                           HorizontalTextAlignment="Center"
                           HeightRequest="48"
                           ReturnType="Next" />
                </Border>

                <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="#F4FAFD" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,44" HeightRequest="48">
                        <Entry x:Name="PasswordEntry"
                               Grid.Column="0"
                               Placeholder="Contrasena"
                               FontSize="17"
                               BackgroundColor="Transparent"
                               TextColor="#555"
                               IsPassword="True"
                               HorizontalTextAlignment="Center"
                               HeightRequest="48"
                               ReturnType="Go" />
                        <Label x:Name="EyeLabel"
                               Grid.Column="1"
                               Text="👁"
                               FontSize="18"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               TextColor="#BBBBBB">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTogglePasswordTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Button x:Name="LoginButton"
                    Text="I N G R E S A R"
                    Clicked="OnLoginClicked"
                    BackgroundColor="#F89A1C"
                    TextColor="White"
                    FontSize="19"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    CornerRadius="10"
                    HorizontalOptions="Fill"
                    Margin="0,10,0,0" />

            <ActivityIndicator x:Name="BusyIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#F89A1C"
                               HorizontalOptions="Center" />

            <Label HorizontalTextAlignment="Center" FontSize="15" TextColor="#555">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Al ingresar aceptas los terminos y&#10;condiciones descritos " />
                        <Span Text="aqui" TextColor="#F89A1C" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTermsTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label HorizontalTextAlignment="Center" FontSize="15" TextColor="#555" Margin="0,4,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="No tienes cuenta? " />
                        <Span Text="Registrate" TextColor="#F89A1C" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRegisterTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label HorizontalTextAlignment="Center" FontSize="14" TextColor="#F89A1C" Margin="0,2,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Olvidaste tu usuario o contrasena? " TextColor="#555" />
                        <Span Text="Recupera tu cuenta" TextColor="#F89A1C" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRecoverAccountTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label x:Name="VersionLabel"
                   HorizontalTextAlignment="Center"
                   FontSize="12"
                   TextColor="#AAAAAA"
                   Margin="0,16,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
