<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.LoginPage"
             Title="Acceso"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="White"
             BackgroundImageSource="bg5.png">
    <ScrollView>
        <VerticalStackLayout Padding="30,70,30,28" Spacing="26">

            <Image Source="logo.png" HeightRequest="220" Aspect="AspectFit" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="18" Margin="0,26,0,0">
                <Entry x:Name="UsernameEntry"
                       Placeholder="Usuario o Correo Electronico"
                       FontSize="22"
                       BackgroundColor="#F4FAFD"
                       TextColor="#555"
                       Keyboard="Email"
                       HorizontalTextAlignment="Center"
                       HeightRequest="62"
                       ReturnType="Next" />

                <Grid ColumnDefinitions="*,50" BackgroundColor="#F4FAFD" HeightRequest="62">
                    <Entry x:Name="PasswordEntry"
                           Grid.Column="0"
                           Placeholder="Contrasena"
                           FontSize="22"
                           BackgroundColor="Transparent"
                           TextColor="#555"
                           IsPassword="True"
                           HorizontalTextAlignment="Center"
                           HeightRequest="62"
                           ReturnType="Go" />
                    <Label x:Name="EyeLabel"
                           Grid.Column="1"
                           Text="👁"
                           FontSize="22"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           TextColor="#BBBBBB">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTogglePasswordTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </VerticalStackLayout>

            <Button x:Name="LoginButton"
                    Text="I N G R E S A R"
                    Clicked="OnLoginClicked"
                    BackgroundColor="#F89A1C"
                    TextColor="White"
                    FontSize="24"
                    FontAttributes="Bold"
                    WidthRequest="330"
                    HeightRequest="72"
                    HorizontalOptions="Center"
                    Margin="0,20,0,0" />

            <ActivityIndicator x:Name="BusyIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#F89A1C"
                               HorizontalOptions="Center" />

            <Label HorizontalTextAlignment="Center" FontSize="18" TextColor="#555">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Al ingresar aceptas los terminos y&#10;condiciones descritos " />
                        <Span Text="aqui" TextColor="#F89A1C" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTermsTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label HorizontalTextAlignment="Center" FontSize="18" TextColor="#555" Margin="0,4,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="No tienes cuenta? " />
                        <Span Text="Registrate" TextColor="#F89A1C" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRegisterTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label x:Name="VersionLabel"
                   HorizontalTextAlignment="Center"
                   FontSize="12"
                   TextColor="#AAAAAA"
                   Margin="0,16,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
