<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.EscenarioProgramaPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <!-- Fuente institucional del modulo de Eventos: estilo implicito que aplica "Como" a TODOS
         los Label de esta pagina (sin tocar cada uno). Los Label que necesiten un peso distinto
         (negrita) lo logran con FontAttributes como ya lo hacen. -->
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Como" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Encabezado: volver al mapa + nombre del escenario + icono calendario.
             El color de fondo lo define cada escenario (lo asigna el code-behind). -->
        <Grid Grid.Row="0" x:Name="HeaderGrid" ColumnDefinitions="Auto,*,Auto" Padding="12,10" BackgroundColor="#5B2A86">

            <!-- Boton claro "volver al mapa": pastilla con flecha + texto -->
            <Border Grid.Column="0" x:Name="VolverMapaBtn" VerticalOptions="Center"
                    BackgroundColor="#33FFFFFF" StrokeThickness="0" Padding="10,6"
                    StrokeShape="RoundRectangle 18">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="‹" FontSize="20" FontAttributes="Bold" TextColor="White"
                           VerticalTextAlignment="Center" />
                    <Label Text="Mapa" FontSize="13" FontAttributes="Bold" TextColor="White"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center" Margin="10,0">
                <!-- Nombre y direccion COMPLETOS: hacen wrap en varias lineas (el header crece
                     en alto) en vez de truncar con "...". Asi el ciudadano ve el nombre entero
                     de la sede y su direccion completa. -->
                <Label x:Name="EscenarioNombre" Text="" FontSize="17" FontAttributes="Bold" TextColor="White"
                       LineBreakMode="WordWrap" MaxLines="3" />
                <Label x:Name="EscenarioDireccion" Text="" FontSize="12" TextColor="#F0E8FA"
                       LineBreakMode="WordWrap" MaxLines="2" />
            </VerticalStackLayout>

            <!-- Acciones del escenario: "como llegar" (abre Maps con la ruta a la direccion) y
                 el calendario del mes. Van juntos a la derecha, alineados arriba para que el
                 nombre/direccion (que ahora puede ocupar varias lineas) crezca sin empujarlos. -->
            <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Start">
                <!-- Como llegar: solo visible si el escenario tiene direccion -->
                <Border x:Name="ComoLlegarBtn" WidthRequest="40" HeightRequest="40" BackgroundColor="#33FFFFFF"
                        StrokeThickness="0" VerticalOptions="Center"
                        StrokeShape="RoundRectangle 20">
                    <Label Text="📍" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnComoLlegarTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Icono de calendario: abre el calendario del mes para elegir otro dia -->
                <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#33FFFFFF"
                        StrokeThickness="0" VerticalOptions="Center"
                        StrokeShape="RoundRectangle 20">
                    <Label Text="📅" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCalendarioTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- Barra del dia seleccionado + boton "hoy" cuando se ve otro dia.
             En una segunda fila va una micro-ayuda tenue (PistaAcciones) con las acciones que
             existen aqui: tocar una actividad, el calendario 📅 y, cuando aplica, 📍 como llegar.
             Antes se veia AMONTONADA bajo el dia; ahora RESPIRA: mas separacion sobre el dia
             (RowSpacing + Margin superior), interlineado comodo (LineHeight) y espacio inferior.
             Al ir dentro de la propia barra no empuja la lista. -->
        <Grid Grid.Row="1" x:Name="DiaBar" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
              RowSpacing="8" Padding="16,14,16,12" BackgroundColor="#F2E9FA">
            <Label Grid.Row="0" Grid.Column="0" x:Name="DiaLabel" Text="" FontSize="16" FontAttributes="Bold"
                   TextColor="#5B2A86" VerticalOptions="Center" />
            <Button Grid.Row="0" Grid.Column="1" x:Name="HoyButton" Text="Hoy" IsVisible="False"
                    FontSize="13" Padding="14,4" CornerRadius="16"
                    BackgroundColor="#5B2A86" TextColor="White" Clicked="OnHoyClicked" />
            <!-- Micro-ayuda discreta: fuente pequena y color tenue, en segunda linea para no
                 tapar la lista. LineHeight para que, si envuelve, los renglones no queden pegados.
                 El code-behind ajusta el texto segun exista o no "como llegar". -->
            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="PistaAcciones" Text=""
                   FontSize="11" TextColor="#9A8AAE" LineBreakMode="WordWrap" LineHeight="1.35" />
        </Grid>

        <!-- Contenido: la ilustracion de la sede es una CAPA DE FONDO (abajo-derecha, grande,
             ahora MAS A LA IZQUIERDA y casi completa en pantalla) y la programacion va ENCIMA
             ocupando TODO el ancho (asi los textos ya no se comprimen ni se parten letra por letra).
             Como la figura queda mas adentro, va MUY TENUE (opacidad 0.50) a modo de marca de agua
             para que el texto se lea 100% por encima. La imagen FLOTA en 3D (flotacion + parallax
             por giroscopio, aplicado en el code-behind). El IsClippedToBounds recorta limpio por si
             el borde roza el limite en pantallas angostas, sin romper el layout. -->
        <Grid Grid.Row="2" x:Name="ContenidoGrid" IsClippedToBounds="True">

            <!-- Ilustracion de la sede (opcional): CAPA DE FONDO. Va declarada ANTES del
                 ScrollView para quedar DEBAJO del contenido (en MAUI el orden de declaracion
                 define el z-order: lo ultimo queda arriba). Anclada abajo-derecha, GRANDE y
                 rebasando el borde derecho (~1/4 queda fuera de pantalla) para un efecto premium.
                 InputTransparent para que no robe toques a la programacion. El tamaño y el empuje
                 fuera de pantalla los calcula el code-behind PROPORCIONAL al dispositivo.
                 Flota en 3D (flotacion + giroscopio) desde el code-behind. -->
            <!-- Opacidad 0.50 (antes 0.80, 0.82, 0.95): NUEVO CRITERIO del usuario — ahora la
                 ilustracion va MAS A LA IZQUIERDA y CASI COMPLETA (code-behind: empuje 0.15 del
                 ancho), por lo que queda mas adentro, sobre la columna de texto. Para que las letras
                 de los eventos SIEMPRE se lean por encima ("si es mas clara se logren ver las letras
                 de los eventos"), la bajamos a 0.50: funciona como MARCA DE AGUA elegante detras del
                 texto — la figura se nota entera y el texto queda claramente al frente, 100% legible.
                 0.50 es el equilibrio: lo bastante tenue para no competir con las letras aunque la
                 figura quede detras de ellas, pero suficiente para que el mono se vea completo y el
                 efecto premium (flotacion + parallax) siga luciendo. InputTransparent e
                 IsClippedToBounds intactos. -->
            <Image Grid.Row="0" x:Name="ImagenEscenario" IsVisible="False"
                   Aspect="AspectFit" InputTransparent="True" Opacity="0.50"
                   HorizontalOptions="End" VerticalOptions="End" />

            <!-- Programacion del dia: va ENCIMA de la imagen y ocupa TODO el ancho de la pagina
                 para que los titulos de las actividades se lean en lineas normales (ya no en
                 columnas angostas que partian las palabras letra por letra). -->
            <ScrollView Grid.Row="0">
                <VerticalStackLayout x:Name="ProgramaStack" Padding="16" Spacing="12">

                    <!-- FASE 3: franja "AHORA / A CONTINUACION". Tarjeta premium que SOLO aparece
                         cuando el dia mostrado es HOY y hay una actividad en curso y/o una proxima.
                         Va como PRIMER hijo del ProgramaStack (antes del CollectionView) para que
                         scrollee junto con la lista y no requiera tocar el Grid raiz ni sus Grid.Row
                         (minimo riesgo para fases 1/2 y el 3D de la imagen). El fondo es un tinte
                         MUY claro del color del escenario; el code-behind rellena los textos, decide
                         su visibilidad (IsVisible) y maneja un leve 'pulso' del punto de 'Ahora'.
                         Toda la tarjeta es tocable (abre el detalle de la actividad 'Ahora' si tiene
                         descripcion); la seccion 'A continuacion' tiene su propio gesto. -->
                    <Border x:Name="FranjaAhora" IsVisible="False"
                            StrokeThickness="0" Padding="14,12"
                            StrokeShape="RoundRectangle 16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFranjaAhoraTocada" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <!-- Bloque "AHORA": punto que late (pulso) + etiqueta + actividad en curso -->
                            <VerticalStackLayout x:Name="FranjaEnCursoStack" Spacing="2" IsVisible="False">
                                <HorizontalStackLayout Spacing="7">
                                    <!-- Punto de 'Ahora': su color es el del escenario; el code-behind
                                         anima su opacidad/escala en bucle mientras la franja este visible.
                                         Es un Border circular (StrokeShape RoundRectangle 5 sobre 10x10)
                                         para seguir el MISMO patron de 'dot' que ya usa el calendario,
                                         en vez de depender de la figura Ellipse. -->
                                    <Border x:Name="FranjaPuntoPulso" WidthRequest="10" HeightRequest="10"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 5"
                                            VerticalOptions="Center" />
                                    <Label x:Name="FranjaEnCursoEtiqueta" Text="AHORA" FontSize="11"
                                           FontAttributes="Bold" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <Label x:Name="FranjaEnCursoTitulo" Text="" FontSize="15" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" MaxLines="2" />
                            </VerticalStackLayout>

                            <!-- Separador tenue solo visible cuando se muestran AMBAS secciones -->
                            <BoxView x:Name="FranjaSeparador" HeightRequest="1" IsVisible="False"
                                     Color="#1A000000" HorizontalOptions="Fill" />

                            <!-- Bloque "A CONTINUACION": mas tenue; su propio gesto abre el detalle
                                 de la PROXIMA actividad si tiene descripcion. -->
                            <VerticalStackLayout x:Name="FranjaProximaStack" Spacing="2" IsVisible="False">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFranjaProximaTocada" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label x:Name="FranjaProximaEtiqueta" Text="A CONTINUACIÓN" FontSize="11"
                                       FontAttributes="Bold" TextColor="#8A7A9E" />
                                <Label x:Name="FranjaProximaTitulo" Text="" FontSize="14"
                                       TextColor="#555" LineBreakMode="TailTruncation" MaxLines="2" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Sin SelectionMode: la seleccion nativa pintaba un fondo gris feo al tocar.
                         En su lugar, cada fila lleva un TapGestureRecognizer; el code-behind
                         (OnActividadTocada) abre el modal SOLO si la actividad tiene descripcion.
                         Asi no hay resaltado gris: el toque es limpio y premium. -->
                    <CollectionView x:Name="ActividadesView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Padding="0,8" ColumnSpacing="12"
                                      BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnActividadTocada" />
                                    </Grid.GestureRecognizers>
                                    <!-- Hora -->
                                    <Label Grid.Column="0" Text="{Binding HoraTexto}" FontSize="15"
                                           FontAttributes="Bold" TextColor="{Binding Color}" WidthRequest="60"
                                           VerticalOptions="Start" />
                                    <!-- Acento vertical con el color del escenario -->
                                    <BoxView Grid.Column="1" WidthRequest="3" Color="{Binding Color}"
                                             VerticalOptions="Fill" HorizontalOptions="Center" />
                                    <!-- Detalle: lineas con formato (negrita/cursiva/color/fuente/tamano)
                                         renderizadas como un unico Label con FormattedText construido en
                                         el code-behind a partir de las lineas de la actividad. -->
                                    <Label Grid.Column="2" FormattedText="{Binding Contenido}"
                                           LineBreakMode="WordWrap" VerticalOptions="Center" />
                                    <!-- Indicador sutil "ver mas": solo visible en filas con descripcion
                                         (TieneDescripcion), sugiere que esa actividad abre el detalle.
                                         No altera el Label de FormattedText. -->
                                    <Label Grid.Column="3" Text="&#8250;" FontSize="22"
                                           TextColor="{Binding Color}" Opacity="0.55"
                                           IsVisible="{Binding TieneDescripcion}"
                                           VerticalOptions="Center" />
                                    <!-- Estrella de FAVORITO LOCAL: control APARTE y tocable por si
                                         mismo. Su TapGestureRecognizer consume el toque, de modo que
                                         tocarla marca/desmarca el favorito y NO abre el detalle (el
                                         gesto de la fila no se dispara). Glifo ★/☆ y color los expone
                                         ActividadItem (relleno + color del escenario cuando es
                                         favorita; contorno gris tenue cuando no). Area tactil comoda
                                         (40x40) para gama baja y alta sin romper el layout: la columna
                                         * del contenido sigue siendo la que se expande. -->
                                    <Label Grid.Column="4" Text="{Binding EstrellaGlifo}" FontSize="22"
                                           TextColor="{Binding EstrellaColor}"
                                           WidthRequest="40" HeightRequest="40"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnFavoritoTocado" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Estado vacio: antes se veia MUY JUNTO. Ahora RESPIRA — dos renglones con
                         jerarquia (mensaje principal + ayuda tenue), interlineado comodo
                         (LineHeight), padding generoso y el icono 📅 SEPARADO del texto (en su
                         propia linea, no pegado a la palabra). Centrado y legible, premium. -->
                    <VerticalStackLayout x:Name="VacioLabel" Spacing="10" IsVisible="False"
                                         HorizontalOptions="Center" VerticalOptions="Center"
                                         Padding="24,40">
                        <Label Text="📅" FontSize="34" HorizontalTextAlignment="Center" Opacity="0.65" />
                        <Label Text="No hay eventos este día en esta sede."
                               FontSize="15" TextColor="#666" HorizontalTextAlignment="Center"
                               LineHeight="1.35" MaxLines="2" LineBreakMode="WordWrap" />
                        <Label Text="Toca el calendario para ver otros días."
                               FontSize="13" TextColor="#9A8AAE" HorizontalTextAlignment="Center"
                               LineHeight="1.35" MaxLines="2" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
