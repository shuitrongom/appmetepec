<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.ReportSuccessPage"
             Title="Reporte recibido"
             BackgroundColor="#F6F8FA">
    <VerticalStackLayout Padding="24" Spacing="18" VerticalOptions="Center">
        <Label Text="Reporte recibido" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#111827" />
        <Label x:Name="MessageLabel" FontSize="16" HorizontalTextAlignment="Center" TextColor="#526070" />
        <Label x:Name="ReportIdLabel" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#111827" />
        <Button Text="Volver al inicio" Clicked="OnHomeClicked" BackgroundColor="#111827" TextColor="White" />
    </VerticalStackLayout>
</ContentPage>
