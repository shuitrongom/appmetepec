<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.ReportSuccessPage"
             Title="Reporte recibido"
             BackgroundColor="#58C5C6"
             BackgroundImageSource="bg4.png">
    <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">
        <Label Text="REPORTE RECIBIDO" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="White" Margin="0,20,0,0" />
        <Image Source="ic_gerencia.png" HeightRequest="140" WidthRequest="140" Aspect="AspectFit" HorizontalOptions="Center" Margin="0,10,0,0" />
        <Label x:Name="ReportIdLabel" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="White" />
        <Label x:Name="MessageLabel" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="White" />
        <Button Text="Volver al inicio" Clicked="OnHomeClicked" BackgroundColor="White" TextColor="#28113E" FontAttributes="Bold" Margin="0,20,0,0" />
    </VerticalStackLayout>
</ContentPage>
