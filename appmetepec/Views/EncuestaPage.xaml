<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.EncuestaPage"
             Title="Encuesta"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Grid BackgroundColor="{AppThemeBinding Light=White, Dark=#1f1f1f}" Padding="25,12" ColumnDefinitions="40,*,40">
            <Label Text="‹" FontSize="30" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelarTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Image Grid.Column="1" Source="placeholder.png" HeightRequest="50" WidthRequest="100" Aspect="AspectFit" HorizontalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">
                <ActivityIndicator x:Name="BusyIndicator" Color="{AppThemeBinding Light=#28113E, Dark=White}" />

                <Border Stroke="{AppThemeBinding Light=#DDD, Dark=#3A3A3A}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="TituloLabel" FontAttributes="Bold" FontSize="17" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" Text="Encuesta de satisfaccion" />
                        <Label Text="Tu opinion nos ayuda a mejorar el servicio." FontSize="12" TextColor="{AppThemeBinding Light=#8A9BA8, Dark=#B0B8C1}" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ResueltoBorder" Stroke="{AppThemeBinding Light=#DDD, Dark=#3A3A3A}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" Padding="16" IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="¿Tu problema se resolvió?" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" />
                        <HorizontalStackLayout Spacing="10">
                            <Button x:Name="ResueltoSiButton" Text="Sí" Clicked="OnResueltoSiClicked" BackgroundColor="{AppThemeBinding Light=#DDD, Dark=#3A3A3A}" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" WidthRequest="100" />
                            <Button x:Name="ResueltoNoButton" Text="No" Clicked="OnResueltoNoClicked" BackgroundColor="{AppThemeBinding Light=#DDD, Dark=#3A3A3A}" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" WidthRequest="100" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="PreguntasContainer" Spacing="18" />

                <VerticalStackLayout Spacing="6">
                    <Label Text="Comentarios adicionales (opcional)" FontSize="13" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" />
                    <Border Stroke="{AppThemeBinding Light=#DDD, Dark=#3A3A3A}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Editor x:Name="ComentarioEditor" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#333, Dark=White}" AutoSize="TextChanges" HeightRequest="90" />
                    </Border>
                </VerticalStackLayout>

                <Button Text="Enviar encuesta" Clicked="OnEnviarClicked" BackgroundColor="#F89A1C" TextColor="White" FontAttributes="Bold" HeightRequest="48" />
                <Button Text="Ahora no" Clicked="OnCancelarClicked" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#28113E, Dark=White}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
