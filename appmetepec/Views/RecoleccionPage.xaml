<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appmetepec.Views.RecoleccionPage"
             Title="Recoleccion"
             BackgroundColor="White">
    <Grid RowDefinitions="Auto,Auto,*">
        <Label Text="RECOLECCION DE BASURA" FontSize="15" FontAttributes="Bold" TextColor="White" BackgroundColor="#545553" Padding="10" HorizontalTextAlignment="Center" />

        <Border Grid.Row="1" Stroke="#DDE3EA" BackgroundColor="White" Padding="14" Margin="14">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <Button Text="BUSCAR RUTAS CERCANAS" Clicked="OnFindRoutesClicked" BackgroundColor="#F89622" TextColor="White" FontAttributes="Bold" FontSize="14" />
                <Label x:Name="LocationLabel" FontSize="12" TextColor="#545553" />
                <Picker x:Name="RoutesPicker" Title="Selecciona una ruta" ItemDisplayBinding="{Binding name}" SelectedIndexChanged="OnRouteSelected" />
                <ActivityIndicator x:Name="BusyIndicator" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="14,0,14,14" Spacing="8">
                <Label x:Name="RouteLabel" FontSize="14" FontAttributes="Bold" TextColor="#111827" />
                <Label x:Name="TruckLabel" FontSize="14" FontAttributes="Bold" TextColor="#111827" />
                <Label x:Name="RouteCoordinatesLabel" FontSize="12" TextColor="#545553" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
