<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- iPhone (1) + iPad (2). Se RESTAURA el iPad: una version anterior ya publicada en App Store
	     soportaba iPad, y Apple PROHIBE dejar de soportar un dispositivo previamente soportado
	     (error 90101 al subir, ver QA1623). Por eso la 1.5.1 debe mantener iPhone+iPad. Android no
	     se ve afectado: este Info.plist es exclusivo de iOS. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Las 4 orientaciones: al soportar iPad (UIDeviceFamily incluye 2), Apple EXIGE declarar
	     tambien PortraitUpsideDown para el multitasking del iPad (error 90474 al subir). Se agrega
	     esa cuarta orientacion. La app sigue disenada vertical; esto es un requisito del bundle de
	     iPad, no un cambio funcional. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<key>NSCameraUsageDescription</key>
	<string>Usamos la camara para agregar una foto o video como evidencia de tu reporte.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Usamos el microfono para grabar el audio de los videos que agregas como evidencia de tu reporte.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Usamos tu galeria para agregar una foto o video como evidencia de tu reporte.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Usamos tu ubicacion para completar la direccion de tu reporte.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Usamos tu ubicacion para completar la direccion de tu reporte y mostrarte el punto exacto en el mapa.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- La app no implementa cifrado propio (solo usa HTTPS estandar del sistema), por lo que esta
	     EXENTA de la declaracion de export compliance de Apple. Declararlo aqui evita que cada
	     build quede atascado en "Falta informacion de exportacion" en App Store Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
